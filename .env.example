# ============================================================================
# GabayPH Environment Configuration Template
# Never commit actual secrets (.env.local) to version control.
# ============================================================================

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Configuration (Safe for Browser with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Service Role Key (SERVER-ONLY — Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Turnstile (Optional — Defaults to Cloudflare official test keys in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Optional AI Assistant (Future Phase — Server-only)
GEMINI_API_KEY=""
NEXT_PUBLIC_ENABLE_AI_ASSISTANT="false"
